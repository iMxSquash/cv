# Supabase: SAME project as the portfolio (repo ../portfolio) and adobe-apps.
# Values: Supabase dashboard > Settings > API. Public (RLS-protected) keys only:
# never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Canonical public URL of the site (metadata, sitemap, JSON-LD, Open Graph).
NEXT_PUBLIC_SITE_URL=https://cv.elwen.dev

# Search console ownership tokens (optional, content of the verification meta tag).
# Not needed with a "Domain" property verified by DNS on elwen.dev (it covers cv.elwen.dev).
# Bing Webmaster Tools also feeds ChatGPT search: worth registering both.
GOOGLE_SITE_VERIFICATION=YOUR_GOOGLE_TOKEN
BING_SITE_VERIFICATION=YOUR_BING_TOKEN

# Birth date (YYYY-MM-DD) used only to print the age on /print. Kept out of Supabase on purpose:
# every cv_* column is publicly readable. Optional: without it the age row is left out.
BIRTH_DATE=YYYY-MM-DD
